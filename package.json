{
  "name": "blog",
  "version": "0.1.0",
  "private": true,
  "imports": {
    "@/*": "./src/*"
  },
  "engines": {
    "node": ">=26.7.0"
  },
  "scripts": {
    "dev": "tsx --env-file-if-exists=.env.local server.ts --dev",
    "build": "next build",
    "start": "tsx --env-file-if-exists=.env.local server.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node scripts/run-tests.mjs",
    "summary:sync": "node --env-file-if-exists=.env.local --loader ./scripts/test-loader.mjs scripts/sync-summaries.ts",
    "db:verify": "node --env-file-if-exists=.env.local scripts/verify-db.mts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:check": "drizzle-kit check",
    "db:studio": "drizzle-kit studio"
  },
