{
  "name": "blog",
  "version": "0.1.0",
  "private": true,
  "imports": {
    "@/*": "./src/*"
  },
  "scripts": {
    "dev": "next dev -p 4400",
    "build": "next build",
    "start": "next start -p 4400",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --loader ./scripts/test-loader.mjs --test src/lib/presence.test.ts src/server/auth/auth.test.ts src/server/services/comments.test.ts src/server/routes/comments.test.ts",
    "db:verify": "node --env-file-if-exists=.env.local scripts/verify-db.mts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:check": "drizzle-kit check",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "better-auth": "1.6.16",
    "drizzle-orm": "^0.45.2",
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.3",
    "hono": "^4.13.7",
    "katex": "^0.18.5",
    "lucide-react": "^1.43.0",
    "next": "16.2.4",
    "next-mdx-remote": "^6.0.0",
    "ogl": "^1.0.11",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-external-links": "^3.0.0",
    "rehype-katex": "^7.0.1",
    "rehype-pretty-code": "^0.14.5",
    "rehype-slug": "^6.0.0",
    "remark-cjk-friendly": "^2.3.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "shiki": "^4.4.3"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.0.0",
    "@better-auth/cli": "1.4.21",
    "@next/eslint-plugin-next": "16.2.4",
    "@tailwindcss/postcss": "^4.2.2",
    "@tailwindcss/typography": "^0.5.16",
    "@types/github-slugger": "^2.0.0",
    "@types/katex": "^0.16.8",
    "@types/node": "^22.15.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3"
  }
}
