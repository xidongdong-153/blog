# Mac Presence Service 的只读地址。Blog 不向采集器写入状态。
PRESENCE_SOURCE_URL=http://127.0.0.1:4401/api/presence

# Better Auth 认证配置
# 站点基准 URL，用于 OAuth 回调与重定向（本地开发默认 http://localhost:4400）
BETTER_AUTH_URL=http://localhost:4400
# Better Auth 密钥（至少 32 字符），可通过 openssl rand -base64 32 生成
BETTER_AUTH_SECRET=

# GitHub OAuth App 凭证（可选，未配置时不展示 GitHub 登录按钮）
# 回调地址需在 GitHub OAuth App 设置为: <BETTER_AUTH_URL>/api/auth/callback/github
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=

# Google OAuth 凭证（可选，未配置时不展示 Google 登录按钮）
# 回调地址需在 Google Cloud Console 设置为: <BETTER_AUTH_URL>/api/auth/callback/google
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=

# 站长邮箱（用于判定前台评论置顶、删除管理权限，以及接收新评论邮件通知）
ADMIN_EMAIL=

# 邮件通知服务配置 (Resend)
# 未配置时会自动降级在控制台打印模拟日志，不会影响本地开发
RESEND_API_KEY=
# 接收友链申请通知的专用邮箱地址，例如：me@xdd.ink
FRIEND_APPLY_NOTIFY_EMAIL=
# 发件人地址，使用 Resend 免费测试域名可填 '喜东东小站 <onboarding@resend.dev>'
RESEND_FROM_EMAIL=

# Turso (libSQL) 数据库配置
# 线上填 Turso 数据库连接串（如 libsql://xxx-username.turso.io），本地可留空或填 file:local.db
TURSO_DATABASE_URL=
# Turso 数据库访问 Token
TURSO_AUTH_TOKEN=
