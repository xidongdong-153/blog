# 活动接口写入密钥，只放在 .env.local，不要以 NEXT_PUBLIC_ 开头
PRESENCE_TOKEN=

# Giscus 评论系统配置
# 访问 https://giscus.app 生成以下参数，并复制到 .env.local 中

# GitHub 仓库路径，格式为 owner/repo
NEXT_PUBLIC_GISCUS_REPO=

# GitHub GraphQL 仓库 ID
NEXT_PUBLIC_GISCUS_REPO_ID=

# GitHub Discussions 分类名称，例如 Announcements 或 General
NEXT_PUBLIC_GISCUS_CATEGORY=General

# GitHub Discussions 分类 ID
NEXT_PUBLIC_GISCUS_CATEGORY_ID=

# 文章与 Discussion 的映射关系，可选 pathname / url / title / og:title，默认 pathname
NEXT_PUBLIC_GISCUS_MAPPING=pathname

# 是否启用反应表情，1 为启用，0 为禁用，默认 1
NEXT_PUBLIC_GISCUS_REACTIONS_ENABLED=1

# 评论输入框位置，可选 top 或 bottom，默认 top
NEXT_PUBLIC_GISCUS_INPUT_POSITION=top

# 界面语言，默认 zh-CN
NEXT_PUBLIC_GISCUS_LANG=zh-CN
