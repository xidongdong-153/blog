# pull 读取旧 Mac 服务，push 读取采集器最近上报的快照。
PRESENCE_READ_MODE=pull
PRESENCE_SOURCE_URL=http://127.0.0.1:4401/api/presence
# 填写 tools/mac-presence/bin/configure 输出的 SHA-256 摘要后启用 PUT 上报。
PRESENCE_REPORT_TOKEN_SHA256=

# Better Auth 认证配置
# 站点基准 URL，用于 OAuth 回调与重定向（本地开发默认 http://localhost:4400）
BETTER_AUTH_URL=http://localhost:4400
# Better Auth 密钥（至少 32 字符），可通过 openssl rand -base64 32 生成
BETTER_AUTH_SECRET=

# GitHub OAuth App 凭证（可选，未配置时不展示 GitHub 登录按钮）
# 回调地址需在 GitHub OAuth App 设置为: <BETTER_AUTH_URL>/api/auth/callback/github
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=

# Google OAuth 凭证（可选，未配置时不展示 Google 登录按钮）
# 回调地址需在 Google Cloud Console 设置为: <BETTER_AUTH_URL>/api/auth/callback/google
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=

# 站长邮箱（用于判定前台评论置顶、删除管理权限，以及接收新评论邮件通知）
ADMIN_EMAIL=

# 邮件通知服务配置 (Resend)
# 未配置时会自动降级在控制台打印模拟日志，不会影响本地开发
RESEND_API_KEY=
# 接收友链申请通知的专用邮箱地址，例如：me@xdd.ink
FRIEND_APPLY_NOTIFY_EMAIL=
# 发件人地址，使用 Resend 免费测试域名可填 '喜东东小站 <onboarding@resend.dev>'
RESEND_FROM_EMAIL=

# 数据库配置（支持本地 SQLite 文件、Turso 云数据库或自建 libSQL）
# - 本地开发留空默认使用仓库根目录 file:local.db
# - 本地/单机生产可填本地文件路径，例如 file:./data/blog.db（也支持直接填路径 ./data/blog.db）
# - Docker Compose 默认落盘容器卷 file:/app/data/blog.db，无需额外配置
# - 远程 Turso / libSQL 填连接串，例如 libsql://xxx-username.turso.io
DATABASE_URL=
# 远程数据库访问令牌（仅连接 Turso 或开启鉴权的远程 libSQL 时必填，本地 SQLite 留空即可）
DATABASE_AUTH_TOKEN=
# 启动时是否自动执行 Drizzle 数据库迁移（默认开启，设为 false 可关闭）
DATABASE_AUTO_MIGRATE=true

# AI 凭据加密主密钥 (AES-256-GCM)
# 必须为 32 字节 Base64 编码，可通过 openssl rand -base64 32 生成
# 中转地址、模型 ID 和 API Key 均在 /settings/ai 页面录入与加密持久化
AI_CREDENTIAL_ENCRYPTION_KEY=
